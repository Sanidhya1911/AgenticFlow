{
  "openapi": "3.0.3",
  "info": {
    "title": "AgenticFlow Sample E-Commerce API",
    "version": "1.0.0",
    "description": "Comprehensive OpenAPI 3.0 specification for testing AgenticFlow OpenAPI parser with nested references, circular schemas, and diverse parameter structures."
  },
  "servers": [
    {
      "url": "https://api.agenticflow.io/v1",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List all orders",
        "description": "Retrieve a paginated list of customer orders with optional status filter.",
        "tags": ["Orders"],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageQuery"
          },
          {
            "$ref": "#/components/parameters/LimitQuery"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter orders by status",
            "schema": {
              "type": "string",
              "enum": ["pending", "processing", "completed", "cancelled"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrderResponse"
                      }
                    }
                  },
                  "required": ["total", "items"]
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "summary": "Create a new order",
        "description": "Creates an order with items, shipping address, and payment method.",
        "tags": ["Orders"],
        "requestBody": {
          "description": "Payload to create a new order",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid order payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{orderId}": {
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "description": "Unique identifier of the order",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getOrderById",
        "summary": "Get order by ID",
        "description": "Fetch details of a single order by its ID.",
        "tags": ["Orders"],
        "responses": {
          "200": {
            "description": "Order details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateOrderStatus",
        "summary": "Update order status",
        "description": "Transition order status to processing, completed, or cancelled.",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order status updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelOrder",
        "summary": "Cancel an order",
        "description": "Deletes or cancels an existing order.",
        "tags": ["Orders"],
        "responses": {
          "204": {
            "description": "Order cancelled successfully"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "Get category hierarchy",
        "description": "Returns hierarchical categories which contain recursive children references.",
        "tags": ["Catalog"],
        "responses": {
          "200": {
            "description": "Hierarchical category list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryNode"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCategory",
        "summary": "Create category node",
        "description": "Create a category node, optionally with nested child categories.",
        "tags": ["Catalog"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryNode"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryNode"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PageQuery": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number for pagination",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "LimitQuery": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Number of items per page",
        "schema": {
          "type": "integer",
          "default": 20,
          "maximum": 100
        }
      }
    },
    "schemas": {
      "BaseEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when record was created"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when record was last updated"
          }
        },
        "required": ["id", "created_at"]
      },
      "GeoLocation": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "float"
          },
          "longitude": {
            "type": "number",
            "format": "float"
          }
        },
        "required": ["latitude", "longitude"]
      },
      "Address": {
        "type": "object",
        "properties": {
          "street": { "type": "string" },
          "city": { "type": "string" },
          "postal_code": { "type": "string" },
          "country": { "type": "string" },
          "coordinates": {
            "$ref": "#/components/schemas/GeoLocation"
          }
        },
        "required": ["street", "city", "country"]
      },
      "ProductItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "sku": { "type": "string" },
          "price": { "type": "number", "minimum": 0 },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "name", "price"]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/ProductItem"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "number"
          }
        },
        "required": ["product", "quantity", "unit_price"]
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "shipping_address": {
            "$ref": "#/components/schemas/Address"
          },
          "payment_method": {
            "type": "string",
            "enum": ["credit_card", "paypal", "crypto"]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": ["customer_id", "items", "shipping_address", "payment_method"]
      },
      "OrderResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseEntity"
          },
          {
            "$ref": "#/components/schemas/CreateOrderRequest"
          },
          {
            "type": "object",
            "properties": {
              "order_status": {
                "type": "string",
                "enum": ["pending", "processing", "completed", "cancelled"]
              },
              "total_amount": {
                "type": "number"
              }
            },
            "required": ["order_status", "total_amount"]
          }
        ]
      },
      "UpdateOrderStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "processing", "completed", "cancelled"]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["status"]
      },
      "CategoryNode": {
        "type": "object",
        "description": "Self-referential schema to test circular reference detection",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryNode"
            }
          }
        },
        "required": ["id", "name"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["code", "message"]
      }
    }
  }
}
